<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 앱 안에서 새 버전 받기, 음성 인식 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 말로 답하기 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 휴대폰의 음성 인식·음성 합성·카메라 앱을 찾을 수 있게 -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 인트로 만화 (쪼코 납치), 구출 장면 -->
        <activity android:name=".IntroActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity android:name=".DecksActivity" android:exported="false" android:label="사건 파일 (단어장)" />
        <activity android:name=".DeckActivity" android:exported="false" android:label="단어장" />
        <activity android:name=".EditActivity" android:exported="false" android:label="단어 확인·고치기"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".StudyActivity" android:exported="false" android:label="괴도의 도전장"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MatchActivity" android:exported="false" android:label="짝 맞추기" />
        <activity android:name=".RecordActivity" android:exported="false" android:label="수사 기록 (부모님용)" />
        <activity android:name=".SettingsActivity" android:exported="false" android:label="설정"
            android:windowSoftInputMode="adjustResize" />

        <receiver android:name=".InstallReceiver" android:exported="false" />
    </application>
</manifest>
